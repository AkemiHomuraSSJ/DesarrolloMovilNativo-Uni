<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/pantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="40sp"
        android:gravity="end"
        android:padding="16dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn7" android:text="7"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btn8" android:text="8"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btn9" android:text="9"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btnDividir" android:text="/"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="operacionPresionada" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn4" android:text="4"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btn5" android:text="5"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btn6" android:text="6"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btnMultiplicar" android:text="x"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="operacionPresionada" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn1" android:text="1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btn2" android:text="2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btn3" android:text="3"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btnRestar" android:text="-"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="operacionPresionada" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnLimpiar" android:text="C"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="limpiarPresionado" />
        <Button android:id="@+id/btn0" android:text="0"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="numeroPresionado" />
        <Button android:id="@+id/btnIgual" android:text="="
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="igualPresionado" />
        <Button android:id="@+id/btnSumar" android:text="+"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:onClick="operacionPresionada" />
    </LinearLayout>

</LinearLayout>
